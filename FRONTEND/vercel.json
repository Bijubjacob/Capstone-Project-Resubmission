{
    "version": 2,
    "builds": [
      {
        "src": "index.html",
        "use": "@vercel/static-build"  
      }
    ],
    "routes": [
      {
        "src": "/Images/(.*)",
        "dest": "/public/Images/$1"  
      },
      {
        "src": "/(.*)",
        "dest": "/$1"  
      }
    ]
  }
  