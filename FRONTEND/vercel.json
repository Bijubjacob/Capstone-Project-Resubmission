{
    "version": 2,
    "builds": [
      {
        "src": "package.json",       
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"         
        }
      }
    ],
    "routes": [
      {
        "src": "/Images/(.*)",
        "dest": "/public/Images/$1" 
      },
      {
        "src": "/(.*)",
        "dest": "/$1" 
      }
    ]
  }
  